{
  "name": "mimar",
  "version": "1.53.5",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.mcp.config.ts",
    "mcp": "vite build -c vite.mcp.config.ts && node dist-mcp/mimar-mcp.mjs",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "start": "electron .",
    "dist": "vite build && electron-builder --win nsis portable --x64",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jspdf": "^4.2.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "zustand": "^5.0.15"
  },
  "productName": "MIMAR",
  "build": {
    "appId": "com.mimar.app",
    "productName": "MIMAR",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Mimar-Setup-${version}.${ext}"
    },
    "files": [
      "dist/**/*",
      "dist-mcp/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "updater.cjs",
      "open-file.cjs",
      "branding/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist-mcp/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "mimar",
        "name": "MIMAR.Plan",
        "description": "MIMAR plan",
        "role": "Editor"
      }
    ],
    "portable": {
      "artifactName": "Mimar-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mbnaveed15-sys",
        "repo": "mimar-app",
        "releaseType": "draft"
      }
    ]
  },
  "description": "MIMAR",
  "main": "electron-main.cjs",
  "type": "module"
}
