{
  "name": "mimar",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "vite build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "jspdf": "^2.5.1",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.14",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "postcss": "^8.4.20",
    "tailwindcss": "^3.4.7",
    "vite": "^5.0.0"
  },
  "productName": "Mimar",
  "build": {
    "appId": "com.mimar.app",
    "productName": "Mimar",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Mimar-Setup-${version}.${ext}"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "preload.js",
      "branding/**/*",
      "package.json"
    ]
  },
  "description": "Mimar 2D floor planner",
  "main": "electron-main.js"
}
